# PublicHost local development environment.
# Copy this file to .env and adjust values for your machine.
# .env is gitignored — never commit it.

# Domains seen by clients.
# Base domain is used for tunnel subdomains: <label>.<base_domain>
PUBLICHOST_BASE_DOMAIN=publichost.run
# Domain clients SSH into.
PUBLICHOST_SSH_DOMAIN=publichost.run

# SSH server bind address and port.
PUBLICHOST_SSH_HOST=0.0.0.0
PUBLICHOST_SSH_PORT=2222

# HTTP reverse proxy bind address and port.
PUBLICHOST_HTTP_HOST=0.0.0.0
PUBLICHOST_HTTP_PORT=8080

# Default tunnel lifetime in minutes.
PUBLICHOST_DEFAULT_LIFETIME_MINUTES=120
# Interval (seconds) between expired-tunnel scans.
PUBLICHOST_EXPIRE_CHECK_INTERVAL_SECONDS=60
# Max concurrent remote-forward tunnels per client IP.
PUBLICHOST_MAX_TUNNELS_PER_IP=2

# Interval (seconds) between relay-liveness heartbeats written to Redis.
PUBLICHOST_HEARTBEAT_INTERVAL_SECONDS=10
# Identifies this relay instance in the heartbeat payload (falls back to hostname).
PUBLICHOST_INSTANCE_ID=

# Redis connection URL. Use "none" to disable Redis locally.
PUBLICHOST_REDIS_URL=none

# In-process cache TTL (seconds) for GET /api/v1/stats.
PUBLICHOST_STATS_CACHE_SECONDS=5
# Comma-separated extra CORS origins for the public REST endpoints (the
# built-in page on the base domain is same-origin and needs none).
PUBLICHOST_CORS_ORIGINS=

# Public CLI release metadata, returned by GET /api/v1/cli/version.
# Latest published CLI version.
PUBLICHOST_CLI_LATEST_VERSION=1.0.0
# Oldest CLI version still supported by the API.
PUBLICHOST_CLI_MIN_SUPPORTED_VERSION=1.0.0
# Release date of the latest CLI (e.g. 2026-08-09).
PUBLICHOST_CLI_RELEASED_AT=
# URL of the latest CLI release page.
PUBLICHOST_CLI_RELEASE_URL=
# One-line install command shown to clients.
PUBLICHOST_CLI_INSTALL_COMMAND=

# WebLogs CSV storage directory.
PUBLICHOST_WEBLOGS_PATH=weblogs

# Path to the SSH host key; generated on first run if missing.
PUBLICHOST_HOST_KEY_PATH=host_key
