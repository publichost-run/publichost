# Example server block for the HOST nginx (runs outside Docker).
# Routes tunnel subdomain traffic to the tunnel service's HTTP reverse proxy.
# SSH traffic is NOT proxied by nginx — it goes straight to the container.
#
# Adjust values to match your .env.docker:
#   PUBLICHOST_BASE_DOMAIN=publichost.run
#   PUBLICHOST_EXTERNAL_HTTP_BIND=127.0.0.1
#   PUBLICHOST_EXTERNAL_HTTP_PORT=8080
#
# Wildcard TLS (certbot --dns-01 for *.<base_domain>) goes on top of this;
# enable HTTP/2 on the 443 listener (`http2 on;`, nginx >= 1.25.1) so browsers
# are not limited to 6 parallel HTTP/1.1 connections per tunnel.
#
# Keep-alive matters here: every new connection from nginx to the proxy that
# reaches a tunnel opens a fresh SSH forwarded-tcpip channel, a full round trip
# to the tunnel client's machine. Do NOT reuse the shared `$connection_upgrade`
# map from nginx.api.conf.example (it sends `Connection: close` for plain
# requests, which disables backend reuse), and pool upstream connections.
# `map` and `upstream` belong in nginx's http {} context; a file under
# sites-enabled/ is already included there.

map $http_upgrade $tunnel_connection {
    default upgrade;
    ''      "";
}

upstream publichost_tunnels {
    server 127.0.0.1:8080;
    keepalive 64;
    keepalive_timeout 60s;
}

# Tunnel subdomains: <label>.publichost.run
server {
    listen 80;
    server_name *.publichost.run publichost.run;

    location / {
        proxy_pass http://publichost_tunnels;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-lived tunnel traffic (WebSocket, SSE, streaming)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tunnel_connection;
        proxy_read_timeout 86400;
    }
}
