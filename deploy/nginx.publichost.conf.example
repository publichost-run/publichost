# Example server block for the HOST nginx (runs outside Docker).
# Routes tunnel subdomain traffic to the tunnel service's HTTP reverse proxy.
# SSH traffic is NOT proxied by nginx — it goes straight to the container.
#
# Adjust values to match your .env.docker:
#   PUBLICHOST_BASE_DOMAIN=publichost.run
#   PUBLICHOST_EXTERNAL_HTTP_BIND=127.0.0.1
#   PUBLICHOST_EXTERNAL_HTTP_PORT=8080
#
# Wildcard TLS (certbot --dns-01 for *.<base_domain>) goes on top of this.
# WebSocket upgrade_map is defined once, shared with nginx.api.conf.example —
# see deploy/README.md for where to put it.

# Tunnel subdomains: <label>.publichost.run
server {
    listen 80;
    server_name *.publichost.run publichost.run;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-lived tunnel traffic (WebSocket, SSE, streaming)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
    }
}
