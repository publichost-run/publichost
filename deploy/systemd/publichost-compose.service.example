# Example systemd unit to bring the Docker Compose stack up on boot.
# Install:
#   sudo cp deploy/systemd/publichost-compose.service.example \
#       /etc/systemd/system/publichost-compose.service
#   # edit WorkingDirectory below to the actual deploy path
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now publichost-compose.service
#
# This unit only starts/stops the stack; image builds and env file setup
# (.env.docker) are done manually, see deploy/README.md.

[Unit]
Description=PublicHost Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/publichost-backend
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
