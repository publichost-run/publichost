# Example server block for the HOST nginx (runs outside Docker).
# Routes the public web frontend domain to the FastAPI backend, including
# the WebLogs WebSocket at /channel/weblogs.
#
# Adjust values to match your .env.docker:
#   PUBLICHOST_FRONTEND_DOMAIN=publichost.io
#   PUBLICHOST_EXTERNAL_API_BIND=127.0.0.1
#   PUBLICHOST_EXTERNAL_API_PORT=8000
#
# Requires the WebSocket upgrade_map below in the http {} context, e.g.
# /etc/nginx/conf.d/upgrade_map.conf (shared with nginx.publichost.conf.example
# if you enable Upgrade there too):
#   map $http_upgrade $connection_upgrade {
#       default upgrade;
#       ''      close;
#   }

server {
    listen 80;
    server_name publichost.io;

    # WebLogs WebSocket: token-authenticated (?token=...), one tunnel per
    # connection. proxy_read_timeout must be >= max tunnel lifetime, or the
    # socket is dropped by nginx before the tunnel actually expires.
    location /channel/weblogs {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
