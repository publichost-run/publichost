# PublicHost Docker Compose environment.
# Copy this file to .env.docker and adjust values for your deployment.
# .env.docker is gitignored — never commit it.

# Domains seen by clients.
PUBLICHOST_BASE_DOMAIN=publichost.run
PUBLICHOST_SSH_DOMAIN=publichost.run
PUBLICHOST_FRONTEND_DOMAIN=publichost.io

# Ports published on the Docker host.
PUBLICHOST_EXTERNAL_SSH_PORT=2222
PUBLICHOST_EXTERNAL_HTTP_PORT=8080
PUBLICHOST_EXTERNAL_API_PORT=8000
# Addresses on the Docker host to bind services to.
PUBLICHOST_EXTERNAL_HTTP_BIND=127.0.0.1
PUBLICHOST_EXTERNAL_API_BIND=127.0.0.1

# Internal ports inside the container.
PUBLICHOST_SSH_HOST=0.0.0.0
PUBLICHOST_SSH_PORT=2222
PUBLICHOST_HTTP_HOST=0.0.0.0
PUBLICHOST_HTTP_PORT=8080
PUBLICHOST_API_HOST=0.0.0.0
PUBLICHOST_API_PORT=8000

# Default tunnel lifetime.
PUBLICHOST_DEFAULT_LIFETIME_MINUTES=120
PUBLICHOST_EXPIRE_CHECK_INTERVAL_SECONDS=60
# Max concurrent remote-forward tunnels per client IP.
PUBLICHOST_MAX_TUNNELS_PER_IP=2

# Interval (seconds) between relay-liveness heartbeats written to Redis.
PUBLICHOST_HEARTBEAT_INTERVAL_SECONDS=10
# Identifies this relay instance in the heartbeat payload (falls back to hostname).
PUBLICHOST_INSTANCE_ID=

# Redis and PostgreSQL (service names inside compose network).
PUBLICHOST_REDIS_URL=redis://redis:6379/0
PUBLICHOST_DATABASE_URL=postgresql+asyncpg://publichost:publichost@postgres:5432/publichost

# PostgreSQL credentials (must match DATABASE_URL above).
PUBLICHOST_POSTGRES_USER=publichost
PUBLICHOST_POSTGRES_PASSWORD=publichost
PUBLICHOST_POSTGRES_DB=publichost

# WebLogs storage inside container.
PUBLICHOST_WEBLOGS_PATH=/app/weblogs

# Public CLI release metadata, returned by GET /api/v1/cli/version.
# Latest published CLI version.
PUBLICHOST_CLI_LATEST_VERSION=1.0.0
# Oldest CLI version still supported by the API.
PUBLICHOST_CLI_MIN_SUPPORTED_VERSION=1.0.0
# Release date of the latest CLI (e.g. 2026-08-09).
PUBLICHOST_CLI_RELEASED_AT=
# URL of the latest CLI release page.
PUBLICHOST_CLI_RELEASE_URL=
# One-line install command shown to clients.
PUBLICHOST_CLI_INSTALL_COMMAND=

# In-process cache TTL (seconds) for GET /api/v1/stats.
PUBLICHOST_STATS_CACHE_SECONDS=5
# Comma-separated allowed CORS origins for the public REST endpoints.
PUBLICHOST_CORS_ORIGINS=https://publichost.io,https://www.publichost.io

# Host key path inside the container.
PUBLICHOST_HOST_KEY_PATH=/data/host_key
