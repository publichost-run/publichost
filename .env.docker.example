# PublicHost self-hosted configuration, read by ./deploy.sh and docker compose.
# ./deploy.sh creates .env.docker from this template and fills in the values
# marked "set by deploy.sh"; edit the rest by hand if needed, then re-run
# ./deploy.sh. .env.docker is gitignored — never commit it.
#
# The Cloudflare API token is NOT stored here: deploy.sh writes it to
# secrets/cloudflare_dns_api_token (gitignored, mode 600), which only the
# Traefik container can read.

# --- Domain (set by deploy.sh) -------------------------------------------
# Tunnels get https://<label>.<base_domain>; https://<base_domain>/ serves the
# landing page and the WebLogs viewer.
PUBLICHOST_BASE_DOMAIN=example.com
# Host clients SSH into (normally the same as the base domain).
PUBLICHOST_SSH_DOMAIN=example.com
# Public SSH port clients connect to (22 needs the host sshd moved elsewhere).
PUBLICHOST_EXTERNAL_SSH_PORT=2222

# --- TLS (set by deploy.sh) ----------------------------------------------
# Email for Let's Encrypt expiry notices.
PUBLICHOST_ACME_EMAIL=admin@example.com
# ACME directory. For testing use the staging CA (untrusted certificates,
# no rate limits): https://acme-staging-v02.api.letsencrypt.org/directory
PUBLICHOST_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- Database (password generated by deploy.sh) --------------------------
PUBLICHOST_POSTGRES_USER=publichost
PUBLICHOST_POSTGRES_PASSWORD=
PUBLICHOST_POSTGRES_DB=publichost

# --- Tunnel limits -------------------------------------------------------
# Default tunnel lifetime in minutes (clients can `extend` it).
PUBLICHOST_DEFAULT_LIFETIME_MINUTES=120
PUBLICHOST_EXPIRE_CHECK_INTERVAL_SECONDS=60
# Max minutes a single `extend` may add, and max total lifetime.
PUBLICHOST_MAX_EXTEND_MINUTES=120
PUBLICHOST_MAX_TOTAL_LIFETIME_MINUTES=1440
# Abuse protection.
PUBLICHOST_MAX_TUNNELS_PER_IP=2
PUBLICHOST_MAX_CONNECTIONS_PER_IP=10
PUBLICHOST_MAX_TOTAL_CONNECTIONS=500

# --- Misc ----------------------------------------------------------------
# Relay heartbeat used by GET /api/v1/stats.
PUBLICHOST_HEARTBEAT_INTERVAL_SECONDS=10
PUBLICHOST_INSTANCE_ID=
PUBLICHOST_STATS_CACHE_SECONDS=5
# Extra origins allowed to call the public REST API from a browser
# (comma-separated). The built-in page is same-origin and needs none.
PUBLICHOST_CORS_ORIGINS=

# Optional CLI release metadata served by GET /api/v1/cli/version.
PUBLICHOST_CLI_LATEST_VERSION=1.0.0
PUBLICHOST_CLI_MIN_SUPPORTED_VERSION=1.0.0
PUBLICHOST_CLI_RELEASED_AT=
PUBLICHOST_CLI_RELEASE_URL=
PUBLICHOST_CLI_INSTALL_COMMAND=

# Traefik image (pin a newer v3 release here to upgrade).
PUBLICHOST_TRAEFIK_IMAGE=traefik:v3.7

# Backend image. Empty = build from this checkout (default). To skip the
# build, use a published release, e.g. ghcr.io/publichost-run/publichost:1.0.0
# (keep it in sync with the checked-out version; or use ./deploy.sh --image).
PUBLICHOST_IMAGE=
